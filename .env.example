# Server-only stage file: ~/.envs/florelle/.env
# Use independent secrets. Hex passwords avoid URL escaping in DATABASE_URL.
POSTGRES_USER=florelle
POSTGRES_DB=florelle
POSTGRES_PASSWORD=replace-with-random-hex-password
JWT_ACCESS_SECRET=replace-with-independent-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=shop@example.com
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM=shop@example.com
FX_API_KEY=replace-with-fx-api-key
FX_OFFLINE=false
FX_BASE_CURRENCY=USD
FX_CACHE_TTL_SECONDS=3600
PUBLIC_FRONTEND_URL=https://florelle.example.com
PUBLIC_API_URL=https://florelle.example.com/api/v1
PLATFORM_COMMISSION_PERCENT=12
PLATFORM_RETAIL_MARKUP=2.5
PAYMENT_PROVIDER=disabled
# Set arcopay only after independent provider settings are configured.
ARCOPAY_API_URL=
ARCOPAY_API_KEY=
ARCOPAY_BEARER_TOKEN=
ARCOPAY_PUBLIC_KEY=
FLORELLE_INTEGRATION_TOKEN=
VV_ADMIN_INTEGRATION_SECRET=
VV_ADMIN_INTEGRATION_ENABLED=false
VV_ADMIN_WEBHOOK_URL=
VV_ADMIN_WEBHOOK_SITE_KEY=
VV_ADMIN_WEBHOOK_SECRET=
VV_ADMIN_WEBHOOK_SECRET_VERSION=1

# Arc Pay Hosted Checkout: SBP + h2h, separate Florelle merchant keys.
# Enable with PAYMENT_PROVIDER=arc_pay after configuring HTTPS origins and portal webhook.
ARC_PAY_BASE_URL=https://api.arcpay.space/v1
ARC_PAY_SECRET_KEY=
ARC_PAY_WEBHOOK_SECRET=
