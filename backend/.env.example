NODE_ENV=development
HOST=127.0.0.1
PORT=5195
DATABASE_URL=postgresql://florelle:florelle-local-only@127.0.0.1:55444/florelle
REDIS_URL=redis://127.0.0.1:56389
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
SMTP_SECURE=false
SMTP_USER=local@florelle.test
SMTP_PASSWORD=local-mailpit
EMAIL_FROM=local@florelle.test
FX_API_KEY=local
FX_OFFLINE=true
MEDIA_ROOT=.runtime/media
PUBLIC_API_URL=http://127.0.0.1:5194/api/v1
PUBLIC_FRONTEND_URL=http://127.0.0.1:5194
PAYMENT_PROVIDER=disabled
PLATFORM_COMMISSION_PERCENT=12
PLATFORM_RETAIL_MARKUP=2.5
# Production: use PostgreSQL/Redis service hostnames, independent secrets,
# real SMTP, FX_OFFLINE=false and provider credentials. No sandbox fallback.
